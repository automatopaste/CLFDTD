clear;
clc;
close all;

%% ============================================================
% Configuration
% ============================================================

c0 = 299792458;

% Use the exact spatial and temporal discretisation from FDTD.
dx0 = 12.4e-6 / 400.0;
courant = 0.5;
dt = courant * dx0 / c0;

% File format:
%   'binary' : raw float32 values
%   'text'   : text file with numeric columns
fileFormat = 'binary';

% Binary layout:
%   1 = one scalar sample per timestep
%   3 = interleaved Ex,Ey,Ez per timestep
componentsPerSample = 3;

% For 3-component files, analyse one component (1=Ex, 2=Ey, 3=Ez).
% Prefer a component with a strong signal at the cavity resonance.
componentToAnalyse = 3;

% Automatic per-run exponential fitting
fitSearchStartTime = 0.2e-12;  % Ignore initial startup transient
fitWindowDuration  = 0.25e-12; % Duration of each candidate fit window
fitWindowStep      = 0.025e-12; % Slide window in 25 fs increments
minFitR2           = 0.98;      % Minimum linear-fit R^2
minEnvelopeRatio   = 1.30;     % Require >=30% envelope change per window

% Envelope processing
smoothWindowCycles = 5;
latePlateauFraction = 0.10;
saturationFraction = 0.90;

% Envelope processing
smoothWindowCycles = 5;   % moving-average window in optical cycles
latePlateauFraction = 0.10;
saturationFraction = 0.90;

%% ============================================================
% Select files and associate each file with its gain
% ============================================================

[fileNames, folder] = uigetfile( ...
    {'*.bin;*.dat;*.raw;*.txt;*.csv', ...
     'Field data files (*.bin, *.dat, *.raw, *.txt, *.csv)'}, ...
    'Select field files for all gain values', ...
    'MultiSelect', 'on');

if isequal(fileNames, 0)
    disp('No files selected.');
    return;
end

if ischar(fileNames)
    fileNames = {fileNames};
end

numRuns = numel(fileNames);

fprintf('\nSelected files:\n');
for k = 1:numRuns
    fprintf('%2d: %s\n', k, fileNames{k});
end

% Enter one signed sigma0 value per file, in the order listed above.
% Example: [-10000 -15000 -20000 -25000 -30000]
gainValues = input( ...
    '\nEnter signed sigma0 values in the listed file order: ');

if numel(gainValues) ~= numRuns
    error('You must enter exactly one gain value per selected file.');
end

gainValues = gainValues(:);

% Sort by gain for plotting and threshold interpolation.
[gainValues, sortIdx] = sort(gainValues);
fileNames = fileNames(sortIdx);

%% ============================================================
% Read the data and calculate the field envelope
% ============================================================

time = cell(numRuns, 1);
field = cell(numRuns, 1);
envelope = cell(numRuns, 1);

growthRate = nan(numRuns, 1);
fitR2 = nan(numRuns, 1);
saturationTime = nan(numRuns, 1);
plateauAmplitude = nan(numRuns, 1);

fitStartUsed = nan(numRuns, 1);
fitEndUsed   = nan(numRuns, 1);

for k = 1:numRuns

    filePath = fullfile(folder, fileNames{k});

    % --------------------------------------------------------
    % Read field samples
    % --------------------------------------------------------
    switch lower(fileFormat)
        case 'binary'
            fid = fopen(filePath, 'rb');
            if fid < 0
                error('Could not open file: %s', filePath);
            end
            raw = fread(fid, inf, 'float32=>double');
            fclose(fid);

        case 'text'
            raw = readmatrix(filePath);
            raw = raw(:);
            raw = raw(isfinite(raw));

        otherwise
            error('fileFormat must be binary or text.');
    end

    if componentsPerSample == 3
        if mod(numel(raw), 3) ~= 0
            error(['File %s does not contain a multiple of 3 ' ...
                   'samples. Check the binary layout.'], fileNames{k});
        end

        samples = reshape(raw, 3, []).';
        E = samples(:, componentToAnalyse);

    elseif componentsPerSample == 1
        E = raw;

    else
        error('componentsPerSample must be 1 or 3.');
    end

    E = E(:);

    if numel(E) < 100
        error('Too few samples in %s.', fileNames{k});
    end

    if any(~isfinite(E))
        error('NaN or Inf found in %s.', fileNames{k});
    end

    N = numel(E);
    t = (0:N-1)' * dt;

    % --------------------------------------------------------
    % Extract the amplitude envelope
    % --------------------------------------------------------
    % The Hilbert transform separates the carrier oscillation
    % from its slowly varying amplitude.
    env = abs(hilbert(E));

    % Smooth over several optical cycles to suppress residual
    % carrier ripple in the envelope.
    %
    % This estimate is for plotting and saturation detection.
    % The fitting interval should avoid the initial transient.
    fReference = 337e12;
    smoothSamples = max(1, round( ...
        smoothWindowCycles / (fReference * dt)));

    if smoothSamples > 1
        env = movmean(env, smoothSamples);
    end

    time{k} = t;
    field{k} = E;
    envelope{k} = env;

        % --------------------------------------------------------
    % Automatically find an exponential growth/decay window
    % --------------------------------------------------------
    %
    % Model:
    %   envelope(t) = A * exp(growthRate * t)
    %
    % Therefore:
    %   log(envelope(t)) = log(A) + growthRate*t
    %
    % Search each run independently to avoid fitting after
    % saturation in high-gain runs.
    % --------------------------------------------------------

    searchStart = max(1, find(t >= fitSearchStartTime, 1, 'first'));

    if isempty(searchStart)
        searchStart = N + 1;
    end

    windowSamples = round(fitWindowDuration / dt);
    stepSamples   = max(1, round(fitWindowStep / dt));

    bestScore = -Inf;
    bestStart = NaN;
    bestEnd   = NaN;
    bestSlope = NaN;
    bestR2    = NaN;

    if windowSamples >= 20 && searchStart + windowSamples - 1 <= N

        % Candidate window start indices.
        candidateStarts = searchStart:stepSamples: ...
                          (N - windowSamples + 1);

        for j = 1:numel(candidateStarts)

            i1 = candidateStarts(j);
            i2 = i1 + windowSamples - 1;

            tw = t(i1:i2);
            ew = env(i1:i2);

            if any(~isfinite(ew)) || any(ew <= 0)
                continue;
            end

            logEnv = log(ew);

            % Reject windows with too little amplitude change.
            envelopeRatio = max(ew) / max(min(ew), realmin);

            if envelopeRatio < minEnvelopeRatio
                continue;
            end

            % Linear fit in log-envelope space.
            p = polyfit(tw, logEnv, 1);
            logFit = polyval(p, tw);

            ssRes = sum((logEnv - logFit).^2);
            ssTot = sum((logEnv - mean(logEnv)).^2);

            r2 = 1 - ssRes / max(ssTot, eps);
            slope = p(1);

            % Reject windows that are insufficiently linear.
            if ~isfinite(r2) || r2 < minFitR2
                continue;
            end

            % Prefer the largest-magnitude exponential rate.
            % This generally favours the unsaturated growth
            % region over the near-zero slope after saturation.
            score = abs(slope);

            if score > bestScore
                bestScore = score;
                bestStart = i1;
                bestEnd   = i2;
                bestSlope = slope;
                bestR2    = r2;
            end
        end
    end

    if isfinite(bestScore)

        growthRate(k) = bestSlope;
        fitR2(k) = bestR2;

        fitStartUsed(k) = t(bestStart);
        fitEndUsed(k)   = t(bestEnd);

        fprintf('  Selected fit interval: %.4f to %.4f ps\n', ...
            fitStartUsed(k)*1e12, fitEndUsed(k)*1e12);

    else
        warning(['No suitable exponential window found for %s. ' ...
                 'Consider changing fitWindowDuration, minFitR2, ' ...
                 'or minEnvelopeRatio.'], fileNames{k});
    end

    % --------------------------------------------------------
    % Estimate saturation time.
    %
    % Estimate the late-time plateau from the median envelope
    % in the last portion of the run. Saturation is the first
    % time the envelope reaches a specified fraction of that
    % plateau, after the exponential fitting interval.
    %
    % This is meaningful primarily for growing, above-threshold
    % runs. A finite run that has not plateaued cannot establish
    % a saturation time.
    % --------------------------------------------------------
    nLate = max(10, round(latePlateauFraction * N));
    nLate = min(nLate, N);

    lateEnv = env(end-nLate+1:end);
    plateau = median(lateEnv);
    plateauAmplitude(k) = plateau;

    % Require an actual growth trend before reporting a time.
    if isfinite(growthRate(k)) && growthRate(k) > 0 && plateau > 0
        searchMask = t >= fitEndUsed(k) & ...
             env >= saturationFraction * plateau;

        idx = find(searchMask, 1, 'first');

        % Reject the result if the final envelope is still
        % substantially below its estimated plateau, or if
        % the signal is still growing strongly at the end.
        tailStart = max(1, N - nLate + 1);
        tailTime = t(tailStart:end);
        tailLogEnv = log(max(env(tailStart:end), realmin));

        if numel(tailTime) >= 20
            pTail = polyfit(tailTime, tailLogEnv, 1);
            tailRate = pTail(1);
        else
            tailRate = NaN;
        end

        plateauVariation = std(lateEnv) / max(plateau, eps);

        if ~isempty(idx) && ...
                isfinite(tailRate) && ...
                abs(tailRate) < 0.10 * max(growthRate(k), eps) && ...
                plateauVariation < 0.30
            saturationTime(k) = t(idx);
        end
    end

    fprintf('\n%s\n', fileNames{k});
    fprintf('  sigma0:            %.6g S/m\n', gainValues(k));
    fprintf('  Growth rate:       %.6g 1/s\n', growthRate(k));
    fprintf('  Fit R^2:           %.5f\n', fitR2(k));

    if isfinite(saturationTime(k))
        fprintf('  Estimated plateau time: %.6g s\n', saturationTime(k));
    else
        fprintf('  Saturation time:   not reliably detected\n');
    end
end

%% ============================================================
% Plot the field envelopes
% ============================================================

figure('Name', 'Cavity field envelopes', 'Color', 'w');
hold on;
grid on;
box on;

colors = lines(numRuns);

for k = 1:numRuns
    plot(time{k} * 1e12, envelope{k}, ...
        'Color', colors(k,:), ...
        'LineWidth', 1.3, ...
        'DisplayName', sprintf('\\sigma_0 = %.4g S/m', gainValues(k)));
end

yscale("log");
xlabel('Time (ps)');
ylabel('Electric-field envelope (V/m)');
title('Cavity field envelopes at point x_2 for different gain values');
legend('Location', 'best', 'Interpreter', 'tex');

%% ============================================================
% Plot the exponential growth rate against gain
% ============================================================

figure('Name', 'Lasing threshold estimate', 'Color', 'w');
hold on;
grid on;
box on;

valid = isfinite(growthRate);

plot(gainValues(valid), growthRate(valid) * 1e-12, ...
    'o-', 'LineWidth', 1.5, 'MarkerSize', 7);

yline(0, 'k--', 'Zero growth', 'LineWidth', 1.2);

xlabel('Signed gain conductivity \sigma_0 (S/m)');
ylabel('Envelope growth rate (ps^{-1})');
title('Lasing threshold from exponential growth rate');

%% ============================================================
% Fit growth rate versus gain and extrapolate zero-crossing
% ============================================================

% Model:
%   gamma(sigma) = a*x + b
%
% where x is normalized gain conductivity.
% The threshold is the extrapolated root gamma(sigma) = 0.
%
% Growth rate is expressed in ps^-1.

polynomialDegree = 1;

thresholdGain = NaN;
crossingFound = false;

valid = isfinite(growthRate) & isfinite(gainValues);

sigmaFit = gainValues(valid);
gammaFit = growthRate(valid) * 1e-12;  % ps^-1

if numel(sigmaFit) >= polynomialDegree + 1

    % Normalize conductivity for numerical stability.
    sigmaCenter = mean(sigmaFit);
    sigmaScale = std(sigmaFit);

    if sigmaScale <= 0
        error('Gain values must contain at least two distinct values.');
    end

    x = (sigmaFit - sigmaCenter) / sigmaScale;

    % Sort samples by conductivity.
    [x, sortIdx] = sort(x);
    sigmaFit = sigmaFit(sortIdx);
    gammaFit = gammaFit(sortIdx);

    % Linear least-squares fit.
    pFit = polyfit(x, gammaFit, polynomialDegree);

    % Evaluate across the measured range and extend the fit
    % to show the extrapolated zero-crossing.
    xMin = min(x);
    xMax = max(x);
    xRange = xMax - xMin;

    xDense = linspace(xMin - 0.5*xRange, ...
                      xMax + 0.5*xRange, 2000);
    gammaDense = polyval(pFit, xDense);

    % Extrapolated zero-crossing: a*x + b = 0.
    if abs(pFit(1)) > eps(max(abs(pFit)))
        xThreshold = -pFit(2) / pFit(1);

        thresholdGain = sigmaCenter + sigmaScale*xThreshold;

        % Require the threshold to lie in the more-negative
        % conductivity direction from the measured range.
        % Remove this condition if extrapolation either way is valid.
        if thresholdGain < min(sigmaFit) || ...
                (min(gammaFit) <= 0 && max(gammaFit) >= 0)
            crossingFound = true;
        end
    end

    % Goodness of fit over measured points only.
    gammaPredicted = polyval(pFit, x);
    ssRes = sum((gammaFit - gammaPredicted).^2);
    ssTot = sum((gammaFit - mean(gammaFit)).^2);
    fitR2 = 1 - ssRes / max(ssTot, eps);

    % Plot measured growth rates and extrapolated fit.
    figure('Name', 'Extrapolated lasing threshold fit', ...
           'Color', 'w');
    hold on;
    grid on;
    box on;

    plot(sigmaFit, gammaFit, 'ko', ...
         'MarkerFaceColor', 'k', ...
         'MarkerSize', 7, ...
         'DisplayName', 'Measured growth rates');

    sigmaDense = sigmaCenter + sigmaScale*xDense;

    inRange = sigmaDense >= min(sigmaFit) & ...
              sigmaDense <= max(sigmaFit);
    outRange = ~inRange;

    plot(sigmaDense(inRange), gammaDense(inRange), ...
         'b-', 'LineWidth', 2, ...
         'DisplayName', 'Linear fit');

    plot(sigmaDense(outRange), gammaDense(outRange), ...
         'b--', 'LineWidth', 2, ...
         'DisplayName', 'Extrapolated fit');

    yline(0, 'k--', 'Zero growth', ...
          'DisplayName', 'Zero growth');

    if isfinite(thresholdGain)
        xline(thresholdGain, 'r--', ...
              sprintf('Threshold: %.6g S/m', thresholdGain), ...
              'LineWidth', 1.5, ...
              'DisplayName', 'Extrapolated threshold');
    end

    xlabel('Signed gain conductivity \sigma_0 (S/m)');
    ylabel('Envelope growth rate (ps^{-1})');
    title(sprintf('Extrapolated threshold fit (R^2 = %.5f)', ...
                  fitR2));
    legend('Location', 'best');

else
    warning('Insufficient valid data for the linear fit.');
end

if crossingFound
    fprintf('\nExtrapolated threshold conductivity: %.8g S/m\n', ...
            thresholdGain);
    fprintf('Polynomial degree: %d\n', polynomialDegree);
    fprintf('Fit R^2: %.6f\n', fitR2);
else
    fprintf(['\nNo accepted threshold crossing was found. ' ...
             'Check the fit slope and extrapolated root.\n']);
end

%% ============================================================
% Plot estimated saturation times
% ============================================================

figure('Name', 'Cavity saturation time', 'Color', 'w');
hold on;
grid on;
box on;

satValid = isfinite(saturationTime);

if any(satValid)
    plot(gainValues(satValid), saturationTime(satValid) * 1e9, ...
        'o-', 'LineWidth', 1.5, 'MarkerSize', 7);
end

xlabel('Signed gain conductivity \sigma_0 (S/m)');
ylabel('Estimated saturation time (ns)');
title('Time to reach the saturated field plateau');

%% ============================================================
% Summary table
% ============================================================

results = table( ...
    string(fileNames(:)), ...
    gainValues, ...
    growthRate, ...
    fitR2, ...
    saturationTime, ...
    plateauAmplitude, ...
    'VariableNames', { ...
        'File', 'Sigma0_S_per_m', 'GrowthRate_per_s', ...
        'FitR2', 'SaturationTime_s', 'LatePlateauAmplitude'});

disp(results);
