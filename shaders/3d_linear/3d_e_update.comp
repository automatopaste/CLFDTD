	vec3 values[];
};

layout (push_constant) uniform PushConstants {
	uvec4 dimensions;		// x, y, z, unused
	vec4 simData;			// ddx, dt, t, unused
	ivec4 simDataInt;		// step, npml, sample buffer size, unused
	// PMLBuffers pmlBuffers;
	SampleBuffer sampleBuffer;
} pushConstants;

void main() {
	ivec3 ijk = ivec3(gl_GlobalInvocationID.xyz);
	int i = ijk.x;
    int j = ijk.y;
    int k = ijk.z;
	uint x = pushConstants.dimensions.x;
	uint y = pushConstants.dimensions.y;
	uint z = pushConstants.dimensions.z;
	ivec3 dim = ivec3(x, y, z);
	ivec3 centre = ivec3(dim / 2);

	// if (all(lessThan(ijk, dim))) {
	// 	vec3 ga = imageLoad(gaSrc, ijk).rgb;
	// 	imageStore(dDst, ijk, vec4(0.0, 1.0, 1.0, 1.0));
	// 	imageStore(eDst, ijk, vec4(1.0, ga.x, 0.0, 1.0));
	// }
	
	if (any(lessThan(ijk, ivec3(1))) || any(greaterThanEqual(ijk, dim))) {
        return;
    }

	vec3 h      = imageLoad(hSrc, ijk).xyz;
    vec3 h_jm1  = imageLoad(hSrc, ijk + ivec3(0, -1, 0)).xyz;
    vec3 h_km1  = imageLoad(hSrc, ijk + ivec3(0, 0, -1)).xyz;
    vec3 h_im1  = imageLoad(hSrc, ijk + ivec3(-1, 0, 0)).xyz;

	float chx = h.z - h_jm1.z - h.y + h_km1.y;
    float chy = h.x - h_km1.x - h.z + h_im1.z;
    float chz = h.y - h_im1.y - h.x + h_jm1.x;
    vec3 curlH = vec3(chx, chy, chz);

    vec3 d = imageLoad(dSrc, ijk).rgb;
    d.xyz += 0.5 * curlH;

	int simStep = pushConstants.simDataInt.x;
	int maxSimStep = pushConstants.simDataInt.z;

	if (all(equal(ijk, centre))) {
		const float dt = pushConstants.simData.y;
		float t0 = 70.0 * dt;
		float spread = 60.0 * dt;
		float t = pushConstants.simData.z;
		const float pi = 3.14159265359;
		float pulse = 50.0 * exp(-0.5 * pow((t0 - t) / spread, 2.0));
		d.z += pulse;
	}

    imageStore(dDst, ijk, vec4(d, 0.0));

	if (all(lessThan(ijk, dim + ivec3(-1, -1, -1)))) {
		vec3 ga = imageLoad(gaSrc, ijk).rgb;
		vec3 e = ga * d;
		imageStore(eDst, ijk, vec4(e, 0.0));

		if (all(equal(ijk, centre + ivec3(5, 5, 5))) && simStep < maxSimStep) {
			pushConstants.sampleBuffer.values[simStep] = e;
		}
	}

