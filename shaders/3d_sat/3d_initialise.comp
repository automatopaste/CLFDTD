#version 460

#include "include/default_header.glsl"
#include "include/global_descriptor.glsl"

layout (local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout (set = 1, binding = 0, rgba32f) uniform image3D eDst;
layout (set = 1, binding = 1, rgba32f) uniform image3D fDst;
layout (set = 1, binding = 2, rgba32f) uniform image3D jDst;
layout (set = 1, binding = 3, rgba32f) uniform image3D hDst;
layout (set = 1, binding = 4, r32f) uniform image3D ePeakDst;

layout (set = 1, binding = 5, rg32f) uniform image3D psiEXDst;
layout (set = 1, binding = 6, rg32f) uniform image3D psiEYDst;
layout (set = 1, binding = 7, rg32f) uniform image3D psiEZDst;

layout (set = 1, binding = 8, rg32f) uniform image3D psiHXDst;
layout (set = 1, binding = 9, rg32f) uniform image3D psiHYDst;
layout (set = 1, binding = 10, rg32f) uniform image3D psiHZDst;

layout (buffer_reference, scalar) buffer ABuffer { float values[]; };
layout (buffer_reference, scalar) buffer BBuffer { float values[]; };

layout (push_constant) uniform PushConstants {
	uvec4 dimensions;		// x, y, z, unused
	vec4 simData;			// ddx, dt, t, unused
	vec4 simData2;			// timeScale
	ivec4 simDataInt;		// step, npml, unused, unused
	ABuffer aBuffer;
	BBuffer bBuffer;
} pushConstants;

void main() {
	ivec3 ijk = ivec3(gl_GlobalInvocationID.xyz);
	uint x = pushConstants.dimensions.x;
	uint y = pushConstants.dimensions.y;
	uint z = pushConstants.dimensions.z;
	ivec3 dim = ivec3(x, y, z);

	if (all(lessThan(ijk, dim))) {
		imageStore(eDst, ijk, vec4(0.0, 0.0, 0.0, 0.0));
		imageStore(fDst, ijk, vec4(0.0, 0.0, 0.0, 0.0));
		imageStore(jDst, ijk, vec4(0.0, 0.0, 0.0, 0.0));
		imageStore(hDst, ijk, vec4(0.0, 0.0, 0.0, 0.0));
		imageStore(ePeakDst, ijk, vec4(0.0, 0.0, 0.0, 0.0));

		imageStore(psiEXDst, ijk, vec4(0.0, 0.0, 0.0, 0.0));
		imageStore(psiEYDst, ijk, vec4(0.0, 0.0, 0.0, 0.0));
		imageStore(psiEZDst, ijk, vec4(0.0, 0.0, 0.0, 0.0));
		imageStore(psiHXDst, ijk, vec4(0.0, 0.0, 0.0, 0.0));
		imageStore(psiHYDst, ijk, vec4(0.0, 0.0, 0.0, 0.0));
		imageStore(psiHZDst, ijk, vec4(0.0, 0.0, 0.0, 0.0));
	}

	// pml parameters

	int npml = pushConstants.simDataInt.y;

	const float sigma_max = 6.0;
	const float kappa_max = 6.0;
	const float m = 3.0;

	if (ijk.x < npml && ijk.y == 0 && ijk.z == 0) {
		int i = ijk.x;
		float xnum = float(i);
		float x = (float(npml) - xnum) / float(npml);

		float sigma = sigma_max * pow(x, m);
		float kappa = 1.0 + (kappa_max - 1.0) * pow(x, m);

		float sigma_eff = sigma / (1.0 + (kappa - 1.0));
		float b = exp(-sigma_eff * 0.5);
		float a = sigma_eff * (b - 1.0);

		pushConstants.aBuffer.values[i] = a;
		pushConstants.bBuffer.values[i] = b;
	}
}