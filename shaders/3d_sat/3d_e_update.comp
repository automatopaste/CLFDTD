#version 460

#include "include/default_header.glsl"
#include "include/global_descriptor.glsl"

layout (local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout (set = 1, binding = 0, rgba32f) uniform image3D eSrc;
layout (set = 1, binding = 1, rgba32f) uniform image3D eDst;
layout (set = 1, binding = 2, rgba32f) uniform image3D fSrc;
layout (set = 1, binding = 3, rgba32f) uniform image3D fDst;
layout (set = 1, binding = 4, rgba32f) uniform image3D jSrc;
layout (set = 1, binding = 5, rgba32f) uniform image3D jDst;
layout (set = 1, binding = 6, rgba32f) uniform image3D hSrc;
layout (set = 1, binding = 7, r32f) uniform image3D ePeakSrc;
layout (set = 1, binding = 8, r32f) uniform image3D ePeakDst;

layout (buffer_reference, scalar) buffer SampleBuffer {
	vec3 values[];
};

layout (push_constant) uniform PushConstants {
	uvec4 dimensions;		// x, y, z, unused
	vec4 simData;			// dx, dt, t, c
	vec4 simData2;			// timeUnit, lengthUnit, source omega0
	ivec4 simDataInt;		// step, npml, sample buffer size, unused
	// PMLBuffers pmlBuffers;
	SampleBuffer sampleBuffer;
} pushConstants;

void main() {
	ivec3 ijk = ivec3(gl_GlobalInvocationID.xyz);
	uint x = pushConstants.dimensions.x;
	uint y = pushConstants.dimensions.y;
	uint z = pushConstants.dimensions.z;
	ivec3 dim = ivec3(x, y, z);
	ivec3 centre = ivec3(dim / 2);
	
	if (any(lessThan(ijk, ivec3(1))) || any(greaterThanEqual(ijk, dim))) {
        return;
    }

	vec3 h      = imageLoad(hSrc, ijk).xyz;
	vec3 h_im1  = imageLoad(hSrc, ijk + ivec3(-1, 0, 0)).xyz;
    vec3 h_jm1  = imageLoad(hSrc, ijk + ivec3(0, -1, 0)).xyz;
    vec3 h_km1  = imageLoad(hSrc, ijk + ivec3(0, 0, -1)).xyz;

	vec3 e = imageLoad(eSrc, ijk).xyz;
	vec3 j = imageLoad(jSrc, ijk).xyz;
	vec3 f = imageLoad(fSrc, ijk).xyz;

	float ePeak = imageLoad(ePeakSrc, ijk).x;

	float dHz_dx = h.z - h_im1.z;
	float dHy_dx = h.y - h_im1.y;
	float dHz_dy = h.z - h_jm1.z;
	float dHx_dy = h.x - h_jm1.x;
	float dHy_dz = h.y - h_km1.y;
	float dHx_dz = h.x - h_km1.x;

	vec3 curlH = vec3(
		(dHz_dy) -
		(dHy_dz),

		(dHx_dz) -
		(dHz_dx),

		(dHy_dx) -
		(dHx_dy)
	);

	const float dx = pushConstants.simData.x;
	const float dt = pushConstants.simData.y;
	const float t = pushConstants.simData.z;
	const float c = pushConstants.simData.w;
	const float timeUnit = pushConstants.simData2.x;
	const float lengthUnit = pushConstants.simData2.y;
	const int simStep = pushConstants.simDataInt.x;
	const int maxSimStep = pushConstants.simDataInt.z;
	
	// Normalised simulation
	const float epsSI = 8.8541878128e-12;
	const float cSI = 299792458.0;
	const float eps0 = 1.0;
	const float mu0 = 1.0;

	// SI material properties for GaAs
	const float lambdaSI = 0.89e-6; // m
	const float T2SI = 0.07e-12; // s
	const float sigmaSI = -70000.0; // S/m
	const float IsSI = 65.2; // kW per cm2

	const float lambda0 = lambdaSI / lengthUnit;
	float T2 = T2SI / timeUnit;
	float sigma0 = sigmaSI * (timeUnit / epsSI);
	const float Is0 = IsSI * (10e6 / 7.957747e5);

	float n = 3.59;

	// for 800x200x200 simulation
	if (abs(ijk.x - centre.x) > 200 || abs(ijk.y - centre.y) > 50 || abs(ijk.z - centre.z) > 50) {
		n = 1.0;
		sigma0 = 0.0;
		T2 = 0.0;
	}

	const float omega0 = (2.0 * 3.14159265359 * c) / lambda0;
	const float epsR = n * n;
	const float epsilon = eps0 * epsR;

	const float amplitude = 1e8;
	const float tau = dt * 20.0;
	const float t0 = 4.0 * tau;
	const float source_omega0 = pushConstants.simData2.z * 10e15 * 2.0 * 3.14159265359 * timeUnit;
	float envelope = exp(-0.5 * pow((t - t0) / tau, 2.0));
	float source = amplitude * envelope * cos(source_omega0 * (t - t0));
	//float source = amplitude * sin(source_omega0 * t);

	ivec3 sourcePosition = centre + ivec3(-150, 0, 0);
	float d = distance(vec3(centre), vec3(ijk));
	const float radius = 5.0;
	if (length(vec3(ijk) - vec3(sourcePosition)) <= radius) {
		float spatial = 0.5 * (1.0 + cos(3.14159265 * d / radius));
		e.z -= spatial * source;
	}

	float Z2 = (1.0 + omega0 * omega0 * T2 * T2);

	float I = 0.5 * c * n * eps0 * ePeak * ePeak;
	float s = 1.0 / (1.0 + I / Is0);

	float B = 8.0 * epsilon * T2 * (dt + T2) + dt * dt * (2.0 * epsilon * Z2 + s * sigma0 * (dt + 2.0 * T2));

	float A1 = (4.0 * dt * s * sigma0 * (dt + 2.0 * T2)) / (B * dx);
	float A2 = (8.0 * epsilon * s * sigma0 * dt) / B;
	float A3 = -(4.0 * dt * (2.0 * epsilon * Z2 + s * sigma0 * (dt + 2.0 * T2))) / B;
	float A4 = (-(8.0 * epsilon * T2 * (dt - T2)) / B) - ((dt * dt * (2.0 * epsilon * Z2 + s * sigma0 * (dt + 2.0 * T2))) / B);

	vec3 fNew = A1 * curlH + A2 * e + A3 * j + A4 * f;
	vec3 jNew = j + (dt / 2.0) * (fNew + f);
	vec3 eNew = e - (dt / (2.0 * epsilon)) * (jNew + j) + (dt / (epsilon * dx)) * curlH;

	float eMag = length(eNew);
	float ePeakNew = max(eMag, ePeak);

	imageStore(eDst, ijk, vec4(eNew, 0.0));
	imageStore(fDst, ijk, vec4(fNew, 0.0));
	imageStore(jDst, ijk, vec4(jNew, 0.0));
	imageStore(ePeakDst, ijk, vec4(ePeakNew, 0.0, 0.0, 0.0));

	if (ijk.x == x / 2 - 50 && ijk.y == y / 2 && ijk.z == z / 2 && simStep < maxSimStep) {
		pushConstants.sampleBuffer.values[simStep] = eNew;
	}
}