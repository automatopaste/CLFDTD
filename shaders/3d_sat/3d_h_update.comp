layout (push_constant) uniform PushConstants {
	uvec4 dimensions;
	vec4 simData;
	vec4 simData2;			// timeUnit, lengthUnit
	ivec4 simDataInt;
	// PMLBuffers pmlBuffers;
} pushConstants;

void main() {
	ivec3 ijk = ivec3(gl_GlobalInvocationID.xyz);
	uint x = pushConstants.dimensions.x;
	uint y = pushConstants.dimensions.y;
	uint z = pushConstants.dimensions.z;
	ivec3 dim = ivec3(x, y, z);
	ivec3 centre = ivec3(dim / 2);

	if (any(lessThan(ijk, ivec3(1))) || any(greaterThanEqual(ijk, dim))) {
        return;
    }

	const float dx = pushConstants.simData.x;
	const float dt = pushConstants.simData.y;
	const float t = pushConstants.simData.z;
	const float c = pushConstants.simData.w;
	const float timeUnit = pushConstants.simData2.x;
	const float lengthUnit = pushConstants.simData2.y;

	//const float eps0 = 8.8541878128e-12;
	//const float mu0 = 1.25663706212e-6;
	const float eps0 = 1.0;
	const float mu0 = 1.0;

	float cdt_dx = dt / (dx * mu0);

	vec3 h = imageLoad(hSrc, ijk).xyz;
    vec3 e = imageLoad(eSrc, ijk).xyz;

	bool interior = ijk.x < dim.x - 1 && ijk.y < dim.y - 1 && ijk.z < dim.z - 1;

	if (interior) {
        vec3 ex1 = imageLoad(eSrc, ijk + ivec3(1, 0, 0)).xyz;
        vec3 ey1 = imageLoad(eSrc, ijk + ivec3(0, 1, 0)).xyz;
        vec3 ez1 = imageLoad(eSrc, ijk + ivec3(0, 0, 1)).xyz;

		float cex = ez1.y - e.y - ey1.z + e.z;
		float cey = ex1.z - e.z - ez1.x + e.x;
		float cez = ey1.x - e.x - ex1.y + e.y;
		vec3 curlE = vec3(cex, cey, cez);

        h.xyz += cdt_dx * curlE;
    } 
    else {
        // x face
        if (ijk.x == dim.x - 1 && ijk.y < dim.y - 1 && ijk.z < dim.z - 1) {
            vec3 ey1 = imageLoad(eSrc, ijk + ivec3(0, 1, 0)).xyz;
            vec3 ez1 = imageLoad(eSrc, ijk + ivec3(0, 0, 1)).xyz;
            float curlE_x = ez1.y - e.y - ey1.z + e.z;
            h.x += cdt_dx * curlE_x;
        }

        // y face
        if (ijk.y == dim.y - 1 && ijk.x < dim.x - 1 && ijk.z < dim.z - 1) {
            vec3 ex1 = imageLoad(eSrc, ijk + ivec3(1, 0, 0)).xyz;
            vec3 ez1 = imageLoad(eSrc, ijk + ivec3(0, 0, 1)).xyz;
            float curlE_y = ex1.z - e.z - ez1.x + e.x;
            h.y += cdt_dx * curlE_y;
        }

        // z face
        if (ijk.z == dim.z - 1 && ijk.x < dim.x - 1 && ijk.y < dim.y - 1) {
            vec3 ex1 = imageLoad(eSrc, ijk + ivec3(1, 0, 0)).xyz;
            vec3 ey1 = imageLoad(eSrc, ijk + ivec3(0, 1, 0)).xyz;
            float curlE_z = ey1.x - e.x - ex1.y + e.y;
            h.z += cdt_dx * curlE_z;
        }
    }

    imageStore(hDst, ijk, vec4(h, 0.0));

	//float e = imageLoad(eSrc, ijk).r;


