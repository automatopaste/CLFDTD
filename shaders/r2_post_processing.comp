#version 460

#include "include/default_header.glsl"
#include "include/global_descriptor.glsl"
#include "include/post_processing_descriptor.glsl"

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

const float bayer[16] = float[16](
     0.0,  8.0,  2.0, 10.0,
    12.0,  4.0, 14.0,  6.0,
     3.0, 11.0,  1.0,  9.0,
    15.0,  7.0, 13.0,  5.0
);

layout (push_constant) uniform constants {
	vec4 hdr;
} pushConstants;

void main() {
	ivec2 coord = ivec2(gl_GlobalInvocationID.xy);

	ivec2 swapchainSize = imageSize(swapchainImage);
	vec2 uv = (vec2(coord) + 0.5) / vec2(swapchainSize);

	// do nothing if thread is outside image
	if (coord.x >= swapchainSize.x || coord.y >= swapchainSize.y) {
		return;
	}

	//vec4 drawColour = texture(drawImage, uv);

	// Position in Bayer matrix (wrap modulo 4)
    int bx = coord.x / 8 & 3;
    int by = coord.y / 8 & 3;
    float threshold = (bayer[by * 4 + bx] + 0.5) / 16.0; // [0,1)

	// Apply dithering per channel
    vec4 outColour = vec4(uv.x * threshold, uv.y * threshold, 1.0, 1.0);
	imageStore(swapchainImage, coord, outColour);
}