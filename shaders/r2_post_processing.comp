#version 460

#include "include/default_header.glsl"
#include "include/global_descriptor.glsl"
#include "include/post_processing_descriptor.glsl"

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

const float bayer[16] = float[16](
     0.0,  8.0,  2.0, 10.0,
    12.0,  4.0, 14.0,  6.0,
     3.0, 11.0,  1.0,  9.0,
    15.0,  7.0, 13.0,  5.0
);

layout (push_constant) uniform constants {
	uvec4 data;
	vec4 scaling; // mult, limit
} pushConstants;

void main() {
	ivec2 coord = ivec2(gl_GlobalInvocationID.xy);

	ivec2 swapchainSize = imageSize(swapchainImage);
	vec2 uv = (vec2(coord) + 0.5) / vec2(swapchainSize);

	// do nothing if thread is outside image
	if (coord.x >= swapchainSize.x || coord.y >= swapchainSize.y) {
		return;
	}

	ivec2 ezImageSize = imageSize(ezImage);

	vec4 ezColour = vec4(0.1, 0.1, 0.1, 1.0);
	if (coord.x < ezImageSize.x && coord.y < ezImageSize.y) {
		const float limit = pushConstants.scaling.y;
		float ez = imageLoad(ezImage, coord).r * pushConstants.scaling.x;
		float eR = abs(clamp(ez, 0.0, limit) / limit);
		float eB = abs(clamp(ez, -limit, 0.0) / limit);

		float gaG = 0.0;
		if (pushConstants.data.x == 1) {
			float ga = imageLoad(gaImage, coord).r;
			gaG = clamp(ga, 0.0, 1.0);
		}

		ezColour.rgb = vec3(eR, gaG, eB);
	}

	imageStore(swapchainImage, coord, ezColour);
}