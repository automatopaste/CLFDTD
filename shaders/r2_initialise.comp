#version 460

#include "include/default_header.glsl"
#include "include/global_descriptor.glsl"

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout (set = 1, binding = 0, r32f) uniform image2D ezDst;
layout (set = 1, binding = 1, r32f) uniform image2D dzDst;
layout (set = 1, binding = 2, r32f) uniform image2D hxDst;
layout (set = 1, binding = 3, r32f) uniform image2D hyDst;
layout (set = 1, binding = 4, r32f) uniform image2D gaDst;
layout (set = 1, binding = 5, r32f) uniform image2D ihxDst;
layout (set = 1, binding = 6, r32f) uniform image2D ihyDst;

layout (buffer_reference, scalar) buffer GI2Buffer { float values[]; };
layout (buffer_reference, scalar) buffer GI3Buffer { float values[]; };
layout (buffer_reference, scalar) buffer GJ2Buffer { float values[]; };
layout (buffer_reference, scalar) buffer GJ3Buffer { float values[]; };
layout (buffer_reference, scalar) buffer FI1Buffer { float values[]; };
layout (buffer_reference, scalar) buffer FI2Buffer { float values[]; };
layout (buffer_reference, scalar) buffer FI3Buffer { float values[]; };
layout (buffer_reference, scalar) buffer FJ1Buffer { float values[]; };
layout (buffer_reference, scalar) buffer FJ2Buffer { float values[]; };
layout (buffer_reference, scalar) buffer FJ3Buffer { float values[]; };

layout (buffer_reference, scalar) buffer PMLBuffers {
	GI2Buffer gi2;
	GI3Buffer gi3;
	GJ2Buffer gj2;
	GJ3Buffer gj3;
	FI1Buffer fi1;
	FI2Buffer fi2;
	FI3Buffer fi3;
	FJ1Buffer fj1;
	FJ2Buffer fj2;
	FJ3Buffer fj3;
};

layout (push_constant) uniform PushConstants {
	uvec4 dimensions;		// x, y, z, unused
	vec4 simData;			// ddx, dt, t, unused
	ivec4 simDataInt;		// step, npml, unused, unused
	PMLBuffers pmlBuffers;
} pushConstants;

void main() {
	ivec2 ij = ivec2(gl_GlobalInvocationID.xy);
	int i = ij.x;
    int j = ij.y;
	uint x = pushConstants.dimensions.x;
	uint y = pushConstants.dimensions.y;

	GI2Buffer gi2 = pushConstants.pmlBuffers.gi2;
	GI3Buffer gi3 = pushConstants.pmlBuffers.gi3;
	GJ2Buffer gj2 = pushConstants.pmlBuffers.gj2;
	GJ3Buffer gj3 = pushConstants.pmlBuffers.gj3;
	FI1Buffer fi1 = pushConstants.pmlBuffers.fi1;
	FI2Buffer fi2 = pushConstants.pmlBuffers.fi2;
	FI3Buffer fi3 = pushConstants.pmlBuffers.fi3;
	FJ1Buffer fj1 = pushConstants.pmlBuffers.fj1;
	FJ2Buffer fj2 = pushConstants.pmlBuffers.fj2;
	FJ3Buffer fj3 = pushConstants.pmlBuffers.fj3;

	// field initial states

	if (i < x && j < y) {
		imageStore(dzDst, ij, vec4(0.0, 0.0, 0.0, 0.0));
		imageStore(ezDst, ij, vec4(0.0, 0.0, 0.0, 0.0));
		imageStore(hxDst, ij, vec4(0.0, 0.0, 0.0, 0.0));
		imageStore(hyDst, ij, vec4(0.0, 0.0, 0.0, 0.0));
		imageStore(gaDst, ij, vec4(1.0, 0.0, 0.0, 0.0));
		imageStore(ihxDst, ij, vec4(0.0, 0.0, 0.0, 0.0));
		imageStore(ihyDst, ij, vec4(0.0, 0.0, 0.0, 0.0));
	}

	// initialise resonator cavity

	const float wg_eps = 9.0;
	const float wg_w = 20.0;
	if (i < x && j < y) {
		vec2 p = vec2(ij);
		vec2 centre = vec2(pushConstants.dimensions.xy / 2);
		if (length(p - centre) < wg_w) {
			imageStore(gaDst, ij, vec4(1.0 / wg_eps, 0.0, 0.0, 0.0));
		}
	}

	// pml parameters

	int npml = pushConstants.simDataInt.y;

	if (i < npml && j == 0) {
		float xnum = float(npml - i);
		float xd = float(npml);
		float xxn = xnum / xd;
		float xn = 0.25 * pow(xxn, 3.0);

		gi2.values[i] = 1.0 / (1.0 + xn);
		gi2.values[x - 1 - i] = 1.0 / (1.0 + xn);
		gi3.values[i] = (1.0 - xn) / (1.0 + xn);
		gi3.values[x - i - 1] = (1.0 - xn) / (1.0 + xn);

		xxn = (xnum - 0.5) / xd;
		xn = 0.25 * pow(xxn, 3.0);

		fi1.values[i] = xn;
		fi1.values[x - 2 - i] = xn;
		fi2.values[i] = 1.0 / (1.0 + xn);
		fi2.values[x - 2 - i] = 1.0 / (1.0 + xn);
		fi3.values[i] = (1.0 - xn) / (1.0 + xn);
		fi3.values[x - 2 - i] = (1.0 - xn) / (1.0 + xn);
	}
	else if (i >= npml && i < x - npml) {
		gi2.values[i] = 1.0;
		gi3.values[i] = 1.0;
		fi1.values[i] = 0.0;
		fi2.values[i] = 1.0;
		fi3.values[i] = 1.0;
	}

	if (j < npml && i == 0) {
		float xnum = float(npml - j);
		float xd = float(npml);
		float xxn = xnum / xd;
		float xn = 0.25 * pow(xxn, 3.0);

		gj2.values[j] = 1.0 / (1.0 + xn);
		gj2.values[y - 1 - j] = 1.0 / (1.0 + xn);
		gj3.values[j] = (1.0 - xn) / (1.0 + xn);
		gj3.values[y - j - 1] = (1.0 - xn) / (1.0 + xn);

		xxn = (xnum - 0.5) / xd;
		xn = 0.25 * pow(xxn, 3.0);

		fj1.values[j] = xn;
		fj1.values[y - 2 - j] = xn;
		fj2.values[j] = 1.0 / (1.0 + xn);
		fj2.values[y - 2 - j] = 1.0 / (1.0 + xn);
		fj3.values[j] = (1.0 - xn) / (1.0 + xn);
		fj3.values[y - 2 - j] = (1.0 - xn) / (1.0 + xn);
	}
	else if (j >= npml && j < y - npml) {
		gj2.values[j] = 1.0;
		gj3.values[j] = 1.0;
		fj1.values[j] = 0.0;
		fj2.values[j] = 1.0;
		fj3.values[j] = 1.0;
	}
}