#version 460

#include "include/default_header.glsl"
#include "include/global_descriptor.glsl"

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout (set = 1, binding = 0, r32f) uniform image2D ezSrc;
layout (set = 1, binding = 1, r32f) uniform image2D hxSrc;
layout (set = 1, binding = 2, r32f) uniform image2D hxDst;
layout (set = 1, binding = 3, r32f) uniform image2D hySrc;
layout (set = 1, binding = 4, r32f) uniform image2D hyDst;
layout (set = 1, binding = 5, r32f) uniform image2D ihxSrc;
layout (set = 1, binding = 6, r32f) uniform image2D ihxDst;
layout (set = 1, binding = 7, r32f) uniform image2D ihySrc;
layout (set = 1, binding = 8, r32f) uniform image2D ihyDst;

layout (buffer_reference, scalar) readonly buffer GI2Buffer { float values[]; };
layout (buffer_reference, scalar) readonly buffer GI3Buffer { float values[]; };
layout (buffer_reference, scalar) readonly buffer GJ2Buffer { float values[]; };
layout (buffer_reference, scalar) readonly buffer GJ3Buffer { float values[]; };
layout (buffer_reference, scalar) readonly buffer FI1Buffer { float values[]; };
layout (buffer_reference, scalar) readonly buffer FI2Buffer { float values[]; };
layout (buffer_reference, scalar) readonly buffer FI3Buffer { float values[]; };
layout (buffer_reference, scalar) readonly buffer FJ1Buffer { float values[]; };
layout (buffer_reference, scalar) readonly buffer FJ2Buffer { float values[]; };
layout (buffer_reference, scalar) readonly buffer FJ3Buffer { float values[]; };

layout (buffer_reference, scalar) buffer PMLBuffers {
	GI2Buffer gi2;
	GI3Buffer gi3;
	GJ2Buffer gj2;
	GJ3Buffer gj3;
	FI1Buffer fi1;
	FI2Buffer fi2;
	FI3Buffer fi3;
	FJ1Buffer fj1;
	FJ2Buffer fj2;
	FJ3Buffer fj3;
};

layout (push_constant) uniform PushConstants {
	uvec4 dimensions;
	vec4 simData;
	ivec4 simDataInt;
	PMLBuffers pmlBuffers;
} pushConstants;

void main() {
	ivec2 ij = ivec2(gl_GlobalInvocationID.xy);
	int i = ij.x;
    int j = ij.y;
	uint x = pushConstants.dimensions.x;
	uint y = pushConstants.dimensions.y;

	float ez = imageLoad(ezSrc, ij).r;

	if (
		i >= 0 && i < x &&
		j >= 0 && j < y - 1
	) {
		float ez_x0 = imageLoad(ezSrc, ivec2(i, j + 1)).r;
		float hx = imageLoad(hxSrc, ij).r;
		float ihx = imageLoad(ihxSrc, ij).r;

		float fi1 = pushConstants.pmlBuffers.fi1.values[i];
		float fj2 = pushConstants.pmlBuffers.fj2.values[j];
		float fj3 = pushConstants.pmlBuffers.fj3.values[j];

		float curl_e = ez - ez_x0;

		float ihxNew = ihx + fi1 * curl_e;
		float hxNew = fj3 * hx + fj2 * 0.5 * (curl_e + ihxNew);
		
		imageStore(ihxDst, ij, vec4(ihxNew, 0.0, 0.0, 0.0));
		imageStore(hxDst, ij, vec4(hxNew, 0.0, 0.0, 0.0));
	}

	if (
		i >= 0 && i < x - 1 &&
		j >= 0 && j < y - 1
	) {
		float ez_y0 = imageLoad(ezSrc, ivec2(i + 1, j)).r;
		float hy = imageLoad(hySrc, ij).r;
		float ihy = imageLoad(ihySrc, ij).r;

		float fj1 = pushConstants.pmlBuffers.fj1.values[j];
		float fi2 = pushConstants.pmlBuffers.fi2.values[i];
		float fi3 = pushConstants.pmlBuffers.fi3.values[i];

		float curl_e = ez_y0 - ez;

		float ihyNew = ihy + fj1 * curl_e;
		float hyNew = fi3 * hy + fi2 * 0.5 * (curl_e + ihyNew);
		
		imageStore(ihyDst, ij, vec4(ihyNew, 0.0, 0.0, 0.0));
		imageStore(hyDst, ij, vec4(hyNew, 0.0, 0.0, 0.0));
	}
}